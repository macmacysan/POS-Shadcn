Table installment_types {
  id TEXT [pk]
  code TEXT [not null, unique]
  name TEXT [not null, unique]
  provider_kind TEXT [not null]
  is_system INTEGER [not null, default: 0]
  is_active INTEGER [not null, default: 1]
  created_by_user_id TEXT
  created_at TEXT [not null]
  updated_at TEXT [not null]
  Note: '''CHECK (provider_kind IN ('IN_HOUSE', 'EXTERNAL'))
CHECK (is_system IN (0, 1))
CHECK (is_active IN (0, 1))'''
}

Table product_catalog_items {
  description TEXT [pk]
  retail_price_centavos INTEGER [not null]
  imported_at TEXT [not null]
  cost_price_centavos INTEGER
  Note: '''CHECK (retail_price_centavos >= 0)
CHECK (cost_price_centavos >= 0)'''
}

Table receipt_types {
  id TEXT [pk, not null]
  code TEXT [not null, unique]
  name TEXT [not null, unique]
  is_system INTEGER [not null, default: 0]
  is_default_visible INTEGER [not null, default: 0]
  is_active INTEGER [not null, default: 1]
  sort_order INTEGER [not null, default: 0]
  created_by_user_id TEXT
  created_at TEXT [not null]
  updated_at TEXT [not null]
  short_name TEXT [not null, default: '']
  Note: '''CHECK (is_system IN (0, 1))
CHECK (is_default_visible IN (0, 1))
CHECK (is_active IN (0, 1))'''
}

Table report_payment_methods {
  id TEXT [pk, not null]
  code TEXT [not null, unique]
  name TEXT [not null, unique]
  is_active INTEGER [not null, default: 1]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  Note: '''CHECK (is_active IN (0, 1))'''
}

Table report_reconciliations {
  report_id TEXT [pk, not null]
  physical_cash_centavos INTEGER [not null]
  cash_remitted_centavos INTEGER [not null]
  cash_variance_centavos INTEGER [not null]
  updated_at TEXT [not null]
  indexes {
    (updated_at) [ name: 'report_reconciliations_updated_idx']
  }
  Note: '''CHECK (cash_remitted_centavos >= 0)'''
}

Table reports {
  id TEXT [pk, not null]
  branch_id TEXT [not null]
  cashier_id TEXT [not null]
  business_date TEXT [not null]
  status TEXT [not null]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  Note: '''CHECK (status IN ('Draft', 'Submitted', 'Locked'))'''
}

Table schema_migrations {
  version INTEGER [pk]
  applied_at TEXT [not null]
}

Table user_branch_assignments {
  user_id TEXT [not null]
  branch_id TEXT [not null]
  indexes {
    (user_id, branch_id) [pk]
  }
}

Table users {
  id TEXT [pk]
  branch_id TEXT
  username TEXT [not null, unique]
  password_hash TEXT [not null]
  display_name TEXT [not null]
  role TEXT [not null]
  is_active INTEGER [not null, default: 1]
  last_login_at TEXT
  created_at TEXT [not null]
  updated_at TEXT [not null]
  must_change_password INTEGER [not null, default: 0]
  first_name TEXT [not null, default: '']
  last_name TEXT [not null, default: '']
  Note: '''CHECK (role IN ('CASHIER', 'ADMIN', 'SUPERVISOR', 'AUDITOR'))
CHECK (is_active IN (0, 1))
CHECK (must_change_password IN (0, 1))'''
}

