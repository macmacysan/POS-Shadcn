}

Table in_house_payments {
  id TEXT [pk]
  contract_id TEXT [not null]
  payment_date TEXT [not null]
  amount_centavos INTEGER [not null]
  reference_number TEXT
  status TEXT [not null, default: 'POSTED']
  voided_at TEXT
  voided_by_user_id TEXT
  void_reason TEXT
  received_by_user_id TEXT
  created_at TEXT [not null]
  updated_at TEXT [not null]
  submission_id TEXT
  replaces_payment_id TEXT
  penalty_centavos INTEGER [not null, default: 0]
  indexes {
    (contract_id) [ name: 'in_house_payments_contract_idx']
  }
  Note: '''CHECK (amount_centavos > 0)
CHECK (status IN ('POSTED', 'VOIDED'))
CHECK (penalty_centavos >= 0)
SQLite partial index in_house_payments_replaces_payment_idx: CREATE INDEX in_house_payments_replaces_payment_idx
          ON in_house_payments (replaces_payment_id)
          WHERE replaces_payment_id IS NOT NULL
SQLite partial UNIQUE index in_house_payments_submission_idx: CREATE UNIQUE INDEX in_house_payments_submission_idx
          ON in_house_payments (contract_id, submission_id)
          WHERE submission_id IS NOT NULL'''
}

Table in_house_schedules {
  id TEXT [pk]
