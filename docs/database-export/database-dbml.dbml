Table installment_contracts {
  id TEXT [pk]
  account_id TEXT [not null]
  branch_id TEXT [not null]
  installment_type_id TEXT [not null]
  contract_number TEXT [not null, unique]
  contract_date TEXT [not null]
  date_released TEXT [not null]
  start_date TEXT [not null]
  first_due_date TEXT [not null]
  payment_frequency TEXT [not null]
  terms TEXT [not null]
  principal_centavos INTEGER [not null, default: 0]
  interest_centavos INTEGER [not null, default: 0]
  down_payment_centavos INTEGER [not null, default: 0]
  fees_centavos INTEGER [not null, default: 0]
  installment_amount_centavos INTEGER [not null, default: 0]
  financed_amount_centavos INTEGER [not null, default: 0]
  total_payable_centavos INTEGER [not null, default: 0]
  status TEXT [not null, default: 'ACTIVE']
  closed_at TEXT
  closed_by_user_id TEXT
  close_reason TEXT
  remarks TEXT
  created_by_user_id TEXT
  created_at TEXT [not null]
  updated_at TEXT [not null]
  schedule_frequency TEXT [not null, default: '']
  configuration_version_id TEXT
  end_date TEXT
  interest_rate_bps INTEGER
  required_down_payment_rate_bps INTEGER
  daily_required_fee_factor INTEGER
  payment_amount_centavos INTEGER
  required_fee_centavos INTEGER
  previous_status TEXT
  down_payment_applied_centavos INTEGER [not null, default: 0]
  indexes {
    (first_due_date) [ name: 'idx_contracts_due_date']
    (branch_id) [ name: 'idx_contracts_branch']
    (account_id) [ name: 'idx_contracts_account']
    (status) [ name: 'idx_contracts_status']
  }
  Note: '''CHECK (payment_frequency IN ('Weekly', 'Bi-weekly', 'Monthly'))
CHECK (principal_centavos >= 0)
CHECK (interest_centavos >= 0)
CHECK (down_payment_centavos >= 0)
CHECK (fees_centavos >= 0)
CHECK (installment_amount_centavos >= 0)
CHECK (financed_amount_centavos >= 0)
CHECK (total_payable_centavos >= 0)
CHECK (status IN ('DRAFT', 'ACTIVE', 'CLOSED', 'VOIDED', 'DEFAULTED'))'''
}

