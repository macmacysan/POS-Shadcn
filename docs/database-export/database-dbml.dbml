  indexes {
    (finance_account_id, sort_order) [ name: 'finance_account_items_account_sort_idx']
    (finance_account_id, sort_order) [unique]
  }
  Note: '''CHECK (sort_order >= 0)
CHECK (quantity > 0)
CHECK (item_price_centavos >= 0)
CHECK (total_centavos >= 0)'''
}

Table finance_accounts {
  id TEXT [pk, not null]
  branch TEXT [not null]
  provider TEXT [not null]
  date_released TEXT [not null]
