    (source_record_id, source_updated_at) [ name: 'google_sheet_imports_record_idx']
    (spreadsheet_id, sheet_name, source_row, source_record_id, source_updated_at) [unique]
  }
  Note: '''CHECK (status IN ('IMPORTED', 'DUPLICATE', 'CONFLICT', 'INVALID', 'FAILED'))'''
}

Table google_sheet_sources {
