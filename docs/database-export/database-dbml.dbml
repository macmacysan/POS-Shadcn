// Read-only DBML projection of database-schema.sql / the matching local SQLite schema.
// CHECK constraints and partial indexes are documented as SQLite-only table notes; DBML cannot express them without changing their semantics.

Table account_contacts {
  id TEXT [pk]
  account_id TEXT [not null]
  contact_type TEXT [not null]
  contact_kind TEXT
  contact_value TEXT [not null]
  is_primary INTEGER [not null, default: 0]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  indexes {
    (account_id, contact_type, contact_value) [unique]
  }
  Note: '''CHECK (contact_type IN ('PHONE', 'EMAIL', 'ADDRESS', 'OTHER'))
CHECK (is_primary IN (0, 1))'''
}

Table accounts {
  id TEXT [pk]
  account_number TEXT [not null, unique]
  display_name TEXT [not null]
  account_type TEXT [not null, default: 'CUSTOMER']
  last_name TEXT [not null, default: '']
  first_name TEXT [not null, default: '']
  middle_name TEXT
  suffix TEXT
  street_subdivision TEXT
  barangay TEXT [not null, default: '']
  city_municipality TEXT [not null, default: '']
  province TEXT [not null, default: '']
  occupation TEXT
  agent TEXT
  referred_by TEXT
  status TEXT [not null, default: 'ACTIVE']
  blacklisted_at TEXT
  blacklisted_by_user_id TEXT
  blacklist_reason TEXT
  is_active INTEGER [not null, default: 1]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  civil_status TEXT
  latitude REAL
  longitude REAL
  landmark_remarks TEXT
  branch_id TEXT
  indexes {
    (branch_id) [ name: 'accounts_branch_idx']
    (status) [ name: 'idx_accounts_status']
  }
  Note: '''CHECK (account_type IN ('CUSTOMER', 'BUSINESS', 'OTHER'))
CHECK (status IN ('ACTIVE', 'BLACKLISTED'))
CHECK (is_active IN (0, 1))'''
}

Table app_settings {
  key TEXT [pk, not null]
  value TEXT [not null]
  updated_at TEXT [not null]
}

Table audit_log_changes {
  id TEXT [pk]
  audit_log_id TEXT [not null]
  column_name TEXT [not null]
  old_value TEXT
  new_value TEXT
  indexes {
    (audit_log_id, column_name) [unique]
  }
}

Table audit_logs {
  id TEXT [pk]
  actor_user_id TEXT
  action TEXT [not null]
  entity_type TEXT [not null]
  entity_id TEXT [not null]
  reason TEXT
  created_at TEXT [not null]
}

Table backup_records {
  id TEXT [pk, not null]
  file_name TEXT [not null]
  local_path TEXT [not null]
  sha256 TEXT [not null]
  size_bytes INTEGER [not null]
  encrypted INTEGER [not null]
  remote_path TEXT
  created_at TEXT [not null]
  indexes {
    (created_at) [ name: 'backup_records_created_idx']
  }
  Note: '''CHECK (encrypted IN (0, 1))'''
}

Table branches {
  id TEXT [pk]
  code TEXT [not null, unique]
  name TEXT [not null, unique]
  is_active INTEGER [not null, default: 1]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  Note: '''CHECK (is_active IN (0, 1))'''
}

Table cash_denominations {
  id TEXT [pk, not null]
  value_centavos INTEGER [not null, unique]
  is_active INTEGER [not null, default: 1]
  sort_order INTEGER [not null, default: 0]
  Note: '''CHECK (value_centavos > 0)
CHECK (is_active IN (0, 1))'''
}

Table cash_out_entries {
  id TEXT [pk, not null]
  daily_report_id TEXT [not null]
  transaction_date TEXT [not null]
  description TEXT [not null]
  amount_centavos INTEGER [not null]
  status TEXT [not null, default: 'POSTED']
  voided_at TEXT
  voided_by_user_id TEXT
  void_reason TEXT
  created_by_user_id TEXT [not null]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  indexes {
    (daily_report_id) [ name: 'idx_cash_out_entries_report']
  }
  Note: '''CHECK (length(transaction_date) = 10)
CHECK (amount_centavos > 0)
CHECK (status IN ('POSTED', 'VOIDED'))'''
}

Table catalog_options {
  id TEXT [pk]
  kind TEXT [not null]
  value TEXT [not null]
  reference_id TEXT
  is_active INTEGER [not null, default: 1]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  indexes {
    (kind, is_active, value) [ name: 'catalog_options_kind_active_idx']
    (kind, value) [unique]
  }
  Note: '''CHECK (kind IN ('CASHIER_EXPENSE_TYPE', 'CASHIER_PAYMENT_TYPE', 'IN_HOUSE_AGENT', 'IN_HOUSE_LOAN_TERM', 'FINANCE_TYPE', 'FINANCE_TERM'))
CHECK (is_active IN (0, 1))'''
}

Table daily_receipt_totals {
  id TEXT [pk, not null]
  daily_report_id TEXT [not null]
  receipt_type_id TEXT [not null]
  quantity INTEGER [not null, default: 0]
  amount_centavos INTEGER [not null, default: 0]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  receipt_name TEXT [not null, default: '']
  receipt_short_name TEXT [not null, default: '']
  indexes {
    (daily_report_id) [ name: 'idx_daily_receipt_totals_report']
    (daily_report_id, receipt_type_id) [unique]
  }
  Note: '''CHECK (quantity >= 0)
CHECK (amount_centavos >= 0)'''
}

Table daily_report_cash_counts {
  id TEXT [pk, not null]
  daily_report_id TEXT [not null]
  denomination_id TEXT [not null]
  quantity INTEGER [not null]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  indexes {
    (daily_report_id) [ name: 'idx_daily_report_cash_counts_report']
    (daily_report_id, denomination_id) [unique]
  }
  Note: '''CHECK (quantity >= 0)'''
}

Table daily_report_deductions {
  id TEXT [pk, not null]
  daily_report_id TEXT [not null]
  deduction_type_id TEXT [not null]
  amount_centavos INTEGER [not null]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  indexes {
    (daily_report_id) [ name: 'idx_daily_report_deductions_report']
    (daily_report_id, deduction_type_id) [unique]
  }
  Note: '''CHECK (amount_centavos >= 0)'''
}

Table daily_report_payment_entries {
  id TEXT [pk, not null]
  daily_report_id TEXT [not null]
  payment_method_id TEXT [not null]
  transaction_date TEXT [not null]
  amount_centavos INTEGER [not null]
  reference_number TEXT
  bank_name TEXT
  payer_name TEXT
  remarks TEXT
  status TEXT [not null, default: 'POSTED']
  voided_at TEXT
  voided_by_user_id TEXT
  void_reason TEXT
  created_by_user_id TEXT [not null]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  payment_method_name TEXT [not null, default: '']
  indexes {
    (payment_method_id, transaction_date) [ name: 'idx_daily_report_payments_method_date']
    (daily_report_id) [ name: 'idx_daily_report_payments_report']
  }
  Note: '''CHECK (length(transaction_date) = 10)
CHECK (amount_centavos > 0)
CHECK (status IN ('POSTED', 'VOIDED'))'''
}

Table daily_reports {
  id TEXT [pk, not null]
  branch_id TEXT [not null]
  cashier_user_id TEXT [not null]
  business_date TEXT [not null]
  opening_cash_centavos INTEGER [not null, default: 0]
  cash_remitted_centavos INTEGER
  status TEXT [not null, default: 'DRAFT']
  submitted_at TEXT
  approved_at TEXT
  approved_by_user_id TEXT
  created_at TEXT [not null]
  updated_at TEXT [not null]
  updated_by_user_id TEXT
  note TEXT
  google_drive_submitted_at TEXT
  telegram_submitted_at TEXT
  indexes {
    (branch_id, business_date) [unique, name: 'idx_daily_reports_branch_business_date']
    (branch_id, business_date) [ name: 'idx_daily_reports_business_date']
    (branch_id, cashier_user_id, business_date) [unique]
  }
  Note: '''CHECK (length(business_date) = 10)
CHECK (opening_cash_centavos >= 0)
CHECK (cash_remitted_centavos IS NULL OR cash_remitted_centavos >= 0)
CHECK (status IN ('DRAFT', 'SUBMITTED', 'APPROVED', 'REOPENED', 'VOIDED'))'''
}

Table deduction_types {
  id TEXT [pk, not null]
  code TEXT [not null, unique]
  name TEXT [not null, unique]
  contribution_code TEXT [not null]
  is_active INTEGER [not null, default: 1]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  Note: '''CHECK (contribution_code IN ('ER', 'EE', 'EE_LOAN'))
CHECK (is_active IN (0, 1))'''
}

Table expense_categories {
  id TEXT [pk, not null]
