  sort_order INTEGER [not null, default: 0]
  created_by_user_id TEXT
  created_at TEXT [not null]
  updated_at TEXT [not null]
  Note: '''CHECK (is_system IN (0, 1))
CHECK (is_active IN (0, 1))'''
}

Table expense_entries {
  id TEXT [pk, not null]
  daily_report_id TEXT [not null]
  category_id TEXT [not null]
  transaction_date TEXT [not null]
  description TEXT [not null]
  receipt_number TEXT
  vat_type TEXT [not null, default: 'NON_VAT']
  vat_amount_centavos INTEGER [not null, default: 0]
  gross_amount_centavos INTEGER [not null]
  payment_method_code TEXT [not null, default: 'CASH']
  reference_number TEXT
  remarks TEXT
  status TEXT [not null, default: 'POSTED']
  voided_at TEXT
  voided_by_user_id TEXT
  void_reason TEXT
  created_by_user_id TEXT [not null]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  indexes {
    (category_id) [ name: 'idx_expense_entries_category']
    (daily_report_id) [ name: 'idx_expense_entries_report']
  }
  Note: '''CHECK (length(transaction_date) = 10)
CHECK (vat_type IN ('VATABLE', 'VAT_EXEMPT', 'ZERO_RATED', 'NON_VAT'))
CHECK (vat_amount_centavos >= 0)
CHECK (gross_amount_centavos > 0)
CHECK (payment_method_code IN ('CASH', 'CHECK', 'BANK_TRANSFER', 'GCASH', 'MAYA', 'OTHER_EWALLET', 'OTHER'))
CHECK (status IN ('POSTED', 'VOIDED'))
CHECK (vat_amount_centavos <= gross_amount_centavos)'''
}

Table expenses {
  id TEXT [pk, not null]
  report_id TEXT [not null]
  type TEXT [not null]
  description TEXT [not null]
  category TEXT [not null]
  receipt_no TEXT [not null]
  vat TEXT [not null, default: '']
  amount_centavos INTEGER [not null]
  created_at TEXT [not null]
  updated_at TEXT [not null]
  status TEXT [not null, default: 'POSTED']
  voided_at TEXT
  voided_by_user_id TEXT
  void_reason TEXT
  created_by_user_id TEXT
  indexes {
    (report_id, status) [ name: 'expenses_report_status_idx']
    (report_id, receipt_no) [ name: 'expenses_report_receipt_no_idx']
    (report_id, vat) [ name: 'expenses_report_vat_idx']
    (report_id, category) [ name: 'expenses_report_category_idx']
    (report_id, type) [ name: 'expenses_report_type_idx']
    (report_id, created_at, id) [ name: 'expenses_report_created_idx']
  }
  Note: '''CHECK (amount_centavos >= 0)
CHECK (status IN ('POSTED', 'VOIDED'))'''
}

Table finance_account_items {
  id TEXT [pk, not null]
  finance_account_id TEXT [not null]
