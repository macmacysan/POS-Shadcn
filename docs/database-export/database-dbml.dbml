  item TEXT [not null]
  serial_no TEXT
  item_price_centavos INTEGER [not null]
  grand_total_centavos INTEGER [not null]
  downpayment_centavos INTEGER [not null]
  balance_centavos INTEGER [not null]
  or_number TEXT
  or_date TEXT
  paid_date TEXT
  remarks TEXT
  created_at TEXT [not null]
  updated_at TEXT [not null]
  status TEXT [not null, default: 'POSTED']
  voided_at TEXT
  voided_by_user_id TEXT
  void_reason TEXT
  indexes {
    (status) [ name: 'finance_accounts_status_idx']
    (branch, date_released, created_at) [ name: 'finance_accounts_branch_date_idx']
  }
  Note: '''CHECK (branch IN ('Goa', 'Tinambac', 'Tigaon', 'Lagonoy'))
CHECK (provider IN ('Home Credit', 'Salmon', 'Skyro'))
CHECK (terms_months BETWEEN 1 AND 12)
CHECK (quantity > 0)
CHECK (item_price_centavos >= 0)
CHECK (grand_total_centavos >= 0)
CHECK (downpayment_centavos >= 0)
CHECK (balance_centavos >= 0)
CHECK (status IN ('POSTED', 'VOIDED'))'''
}

